{
  "name": "pos-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/pos-web",
    "apps/mobile-pwa",
    "apps/backoffice"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:pos": "npm run dev --workspace apps/pos-web",
    "dev:mobile": "npm run dev --workspace apps/mobile-pwa",
    "dev:backoffice": "npm run dev --workspace apps/backoffice",
    "build:core": "npm run build --workspace apps/pos-web --workspace apps/mobile-pwa --if-present",
    "build:backoffice": "npm run build --workspace apps/backoffice --if-present",
    "lint:core": "npm run lint --workspace apps/pos-web --workspace apps/mobile-pwa --if-present",
    "lint:backoffice": "npm run lint --workspace apps/backoffice --if-present",
    "test:core": "npm run test --workspace apps/pos-web --workspace apps/mobile-pwa --if-present",
    "test:backoffice": "npm run test --workspace apps/backoffice --if-present"
  },
  "engines": {
    "node": ">=24"
  }
}
